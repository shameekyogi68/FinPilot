{
  "name": "runway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-env.mjs generate && next build",
    "vercel-build": "node scripts/prisma-env.mjs generate && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "postinstall": "node scripts/prisma-env.mjs generate",
    "db:generate": "node scripts/prisma-env.mjs generate",
    "db:migrate": "node scripts/prisma-env.mjs migrate dev",
    "db:studio": "node scripts/prisma-env.mjs studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed"
  },
