generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float
  type      String   // "income" or "expense"
  category  String
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // "income" or "expense"
  createdAt DateTime @default(now())
}

model Budget {
  id           String   @id @default(cuid())
  category     String
  monthly_limit Float
  essential    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Goal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Float
  currentAmount Float   @default(0)
  deadline     DateTime?
  createdAt    DateTime @default(now())
}

model Investment {
  id             String    @id @default(cuid())
  name           String
  type           String    // "stock" | "equity_mf" | "debt_mf" | "fd" | "ppf" | "gold" | "other"
  category       String    // "equity" | "debt" | "gold" | "cash" | "other" — used for allocation rollup
  investedAmount Float
  currentValue   Float
  units          Float?
  symbol         String?   // Yahoo ticker (stock, e.g. "RELIANCE.NS") or mfapi.in scheme code (mutual fund)
  purchaseDate   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AICache {
  id           String   @id @default(cuid())
  insightType  String
  period       String
  value        String
  updatedAt    DateTime @updatedAt

  @@unique([insightType, period])
}

model Profile {
  id                     Int      @id @default(1)
  name                   String   @default("You")
  email                  String?
  currency               String   @default("INR")
  monthly_income         Float    @default(0)
  savings_target         Float    @default(0)
  theme                  String   @default("dark")
  default_month_view     String   @default("current")
  ai_enabled             Boolean  @default(true)
  income_averaging_months Int     @default(3)
  safety_buffer_months   Float    @default(3)
  target_equity_pct      Float    @default(0)
  target_debt_pct        Float    @default(0)
  target_gold_pct        Float    @default(0)
  target_cash_pct        Float    @default(0)
  risk_profile           String   @default("balanced") // "conservative" | "balanced" | "aggressive"
  rebalance_threshold_pct Float   @default(5)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
